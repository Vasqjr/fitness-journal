{
  "family": "fitness-journal-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::444952541827:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "fitness-journal-backend",
      "image": "444952541827.dkr.ecr.us-east-1.amazonaws.com/fitness-journal-backend:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "secrets": [
        {
          "name": "DB_URL",
          "valueFrom": "/fitness-journal/DB_URL"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "/fitness-journal/DB_USERNAME"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "/fitness-journal/DB_PASSWORD"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "/fitness-journal/JWT_SECRET"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fitness-journal-backend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:8080/actuator/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
